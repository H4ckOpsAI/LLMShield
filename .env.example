# ==============================================================================
# LLMShield - Environment Configuration Template
# Copy this file to .env and configure values before starting services.
# NEVER commit the actual .env file or real secrets to source control.
# ==============================================================================

# Required: Groq Cloud API Key for Semantic Injection Detection & Output Critic
# Obtain your API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: Bearer Session TTL in hours (Default: 8)
SESSION_TTL_HOURS=8

# Optional: Enable development demo accounts and passwordless demo-login (true/false)
# Default is 'false'. Set to 'true' only in local development/demonstration environments.
ENABLE_DEMO_ACCOUNTS=false

# Optional: Development Demo Account Password Overrides
# DEMO_EMPLOYEE_PASSWORD=YourDevEmployeePassword!
# DEMO_SOC_PASSWORD=YourDevSocAdminPassword!

# Optional: Comma-separated list of trusted reverse proxy IPs for client IP resolution
# TRUSTED_PROXIES=127.0.0.1,10.0.0.1
